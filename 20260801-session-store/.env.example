# 値はここに書き込まず、実行環境で設定してください。
# Vertex AI と Session Store の Google Cloud プロジェクト
GOOGLE_CLOUD_PROJECT=nnyn-dev
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_AGENT_ENGINE=projects/nnyn-dev/locations/us-central1/reasoningEngines/your-agent-engine-id
SESSION_STORE_USER_ID=verification-user
# Claude Haiku 4.5 を呼び出す Vertex AI リージョン（Session Store のリージョンとは別に指定可能）
VERTEX_AI_LOCATION=us-east5
# Claude のローカルトランスクリプトを保持する作業ディレクトリ
CLAUDE_SESSION_CWD=.
