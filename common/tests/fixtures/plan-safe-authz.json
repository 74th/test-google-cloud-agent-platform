{
  "resource_changes": [
    {
      "address": "google_network_services_authz_extension.iap",
      "type": "google_network_services_authz_extension",
      "change": {
        "actions": ["create"],
        "after": {
          "project": "nnyn-dev",
          "location": "us-central1",
          "name": "common-egress-iap-authz",
          "service": "iap.googleapis.com",
          "fail_open": true,
          "metadata": {
            "iamEnforcementMode": "DRY_RUN",
            "iapPolicyVersion": "V1"
          }
        }
      }
    },
    {
      "address": "google_network_security_authz_policy.iap",
      "type": "google_network_security_authz_policy",
      "change": {
        "actions": ["create"],
        "after": {
          "project": "nnyn-dev",
          "location": "us-central1",
          "name": "common-egress-iap-policy",
          "policy_profile": "REQUEST_AUTHZ",
          "action": "CUSTOM",
          "target": [{
            "resources": ["projects/nnyn-dev/locations/us-central1/agentGateways/common-egress"]
          }],
          "custom_provider": [{
            "authz_extension": [{
              "resources": ["projects/nnyn-dev/locations/us-central1/authzExtensions/common-egress-iap-authz"]
            }]
          }]
        }
      }
    }
  ]
}
